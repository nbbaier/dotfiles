#!/usr/bin/env bash

# Enhanced dotfiles management script
# Based on: https://github.com/webpro/dotfiles/blob/main/bin/dot
#           https://github.com/holman/dotfiles/blob/master/bin/dot

# Set DOTFILES environment variable if not set
export DOTFILES="${DOTFILES:-$HOME/.dotfiles}"

BIN_NAME=$(basename "$0")
COMMAND_NAME=$1
SUB_COMMAND_NAME=$2

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
info() {
    printf "${BLUE}[INFO]${NC} $1\n"
}

success() {
    printf "${GREEN}[SUCCESS]${NC} $1\n"
}

warn() {
    printf "${YELLOW}[WARN]${NC} $1\n"
}

error() {
    printf "${RED}[ERROR]${NC} $1\n"
    exit 1
}

sub_help() {
	echo "Usage: $BIN_NAME <command> [options]"
	echo
	echo "Dotfiles Management Commands:"
	echo "   status            Show dotfiles status and git information"
	echo "   sync              Sync dotfiles with remote repository"
	echo "   backup            Create backup of current dotfiles"
	echo "   restore <file>    Restore dotfiles from backup"
	echo "   link              Link all dotfiles to their destinations"
	echo "   unlink            Unlink all dotfiles (with confirmation)"
	echo "   check             Check for broken symlinks and missing files"
	echo
	echo "System Management:"
	echo "   clean             Clean up caches (brew, cargo, gem, go, uv)"
	echo "   install           Run full installation process"
	echo "   update            Update packages and package managers"
	echo "   macos             Apply macOS system defaults"
	echo
	echo "Development:"
	echo "   edit              Open dotfiles in IDE ($EDITOR)"
	echo "   packages          Show installed packages"
	echo "   diff              Show git diff of dotfiles"
	echo
	echo "Utilities:"
	echo "   help              This help message"
	echo "   version           Show version information"
}

# Dotfiles Management Commands
sub_status() {
    info "Dotfiles Status"
    echo "Repository: $DOTFILES"
    echo "Branch: $(git -C "$DOTFILES" branch --show-current 2>/dev/null || echo 'Not a git repository')"
    echo "Last commit: $(git -C "$DOTFILES" log -1 --format='%h - %s (%cr)' 2>/dev/null || echo 'No commits')"
    echo "Uncommitted changes: $(git -C "$DOTFILES" status --porcelain | wc -l | tr -d ' ') files"
    echo
    info "Symlink Status:"
    sub_check
}

sub_sync() {
    info "Syncing dotfiles with remote..."
    cd "$DOTFILES"
    
    if git remote get-url origin >/dev/null 2>&1; then
        git fetch origin
        if [ "$(git rev-list HEAD...origin/main --count)" -gt 0 ]; then
            info "Pulling changes from remote..."
            git pull origin main
        else
            success "Already up to date"
        fi
    else
        warn "No remote repository configured"
    fi
}

sub_backup() {
    local backup_dir="$DOTFILES/backups/$(date +%Y%m%d_%H%M%S)"
    info "Creating backup in $backup_dir"
    
    mkdir -p "$backup_dir"
    cp -r "$DOTFILES" "$backup_dir/dotfiles_backup"
    success "Backup created: $backup_dir"
}

sub_restore() {
    local backup_file="$1"
    if [ -z "$backup_file" ]; then
        error "Please specify backup file: $BIN_NAME restore <backup_path>"
    fi
    
    if [ ! -d "$backup_file" ]; then
        error "Backup directory not found: $backup_file"
    fi
    
    warn "This will overwrite current dotfiles. Continue? (y/N)"
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
        info "Restoring from $backup_file..."
        cp -r "$backup_file"/* "$DOTFILES/"
        success "Restore completed"
    else
        info "Restore cancelled"
    fi
}

sub_link() {
    info "Linking dotfiles..."
    
    if [ -f "$DOTFILES/bin/link_config" ]; then
        info "Linking config files..."
        source "$DOTFILES/bin/link_config"
    fi
    
    if [ -f "$DOTFILES/bin/link_home" ]; then
        info "Linking home files..."
        source "$DOTFILES/bin/link_home"
    fi
    
    if [ -f "$DOTFILES/bin/link_ides" ]; then
        info "Linking IDE configs..."
        source "$DOTFILES/bin/link_ides"
    fi
    
    success "All dotfiles linked"
}

sub_unlink() {
    warn "This will remove all symlinked dotfiles. Continue? (y/N)"
    read -r response
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        info "Unlink cancelled"
        return
    fi
    
    info "Unlinking dotfiles..."
    
    # Find and remove symlinks that point to dotfiles
    find "$HOME" -maxdepth 1 -type l -exec sh -c '
        for link; do
            target=$(readlink "$link")
            if [[ "$target" == *"$DOTFILES"* ]]; then
                echo "Removing $link -> $target"
                rm "$link"
            fi
        done
    ' _ {} +
    
    # Remove config symlinks
    if [ -d "$XDG_CONFIG_HOME" ]; then
        find "$XDG_CONFIG_HOME" -type l -exec sh -c '
            for link; do
                target=$(readlink "$link")
                if [[ "$target" == *"$DOTFILES"* ]]; then
                    echo "Removing $link -> $target"
                    rm "$link"
                fi
            done
        ' _ {} +
    fi
    
    success "All dotfiles unlinked"
}

sub_check() {
    local broken_links=0
    local missing_files=0
    
    info "Checking for broken symlinks..."
    while IFS= read -r -d '' link; do
        if [ ! -e "$link" ]; then
            echo "  Broken: $link"
            ((broken_links++))
        fi
    done < <(find "$HOME" -maxdepth 1 -type l -print0 2>/dev/null)
    
    if [ -d "$XDG_CONFIG_HOME" ]; then
        while IFS= read -r -d '' link; do
            if [ ! -e "$link" ]; then
                echo "  Broken: $link"
                ((broken_links++))
            fi
        done < <(find "$XDG_CONFIG_HOME" -type l -print0 2>/dev/null)
    fi
    
    info "Checking for missing source files..."
    for file in "$DOTFILES"/config/*; do
        if [ -f "$file" ]; then
            local basename_file=$(basename "$file")
            local target="$XDG_CONFIG_HOME/$basename_file"
            if [ -L "$target" ] && [ ! -e "$target" ]; then
                echo "  Missing source: $file"
                ((missing_files++))
            fi
        fi
    done
    
    if [ $broken_links -eq 0 ] && [ $missing_files -eq 0 ]; then
        success "All symlinks are valid"
    else
        warn "Found $broken_links broken symlinks and $missing_files missing source files"
    fi
}

# System Management Commands
sub_clean() {
    info "Cleaning up caches..."
    
    if command -v brew >/dev/null 2>&1; then
        info "Cleaning brew cache..."
        brew cleanup
    fi
    
    if command -v cargo >/dev/null 2>&1; then
        info "Cleaning cargo cache..."
        cargo cache --autoclean
    fi
    
    if command -v gem >/dev/null 2>&1; then
        info "Cleaning gem cache..."
        gem cleanup
    fi
    
    if command -v go >/dev/null 2>&1; then
        info "Cleaning go cache..."
        go clean -cache
    fi
    
    if command -v uv >/dev/null 2>&1; then
        info "Cleaning uv cache..."
        uv cache clean
    fi
    
    success "Cache cleanup completed"
}

sub_install() {
    info "Running full installation..."
    if [ -f "$DOTFILES/install.sh" ]; then
        source "$DOTFILES/install.sh"
    else
        error "Install script not found: $DOTFILES/install.sh"
    fi
}

sub_update() {
    info "Updating packages and package managers..."
    if command -v topgrade >/dev/null 2>&1; then
        topgrade
    else
        warn "topgrade not found, running individual updates..."
        sub_clean
        if command -v brew >/dev/null 2>&1; then
            brew update && brew upgrade
        fi
    fi
}

sub_macos() {
    info "Applying macOS system defaults..."
    for DEFAULTS_FILE in "${DOTFILES}"/macos/*.sh; do
        if [ -f "$DEFAULTS_FILE" ] && [[ ! "$DEFAULTS_FILE" == *".bak"* ]]; then
            info "Applying $(basename "$DEFAULTS_FILE")"
            source "$DEFAULTS_FILE"
        fi
    done
    success "macOS defaults applied. Some changes may require a logout/restart to take effect."
}

# Development Commands
sub_edit() {
    info "Opening dotfiles in $EDITOR..."
    if [ -n "$EDITOR" ]; then
        $EDITOR "$DOTFILES"
    else
        error "EDITOR environment variable not set"
    fi
}

sub_packages() {
    info "Installed packages:"
    echo
    if command -v brew >/dev/null 2>&1; then
        echo "Homebrew packages:"
        brew list --formula
        echo
        echo "Homebrew casks:"
        brew list --cask
        echo
    fi
    
    if command -v npm >/dev/null 2>&1; then
        echo "NPM global packages:"
        npm list -g --depth=0 2>/dev/null | grep -v '^├\|^└' | tail -n +2
        echo
    fi
    
    if command -v cargo >/dev/null 2>&1; then
        echo "Cargo packages:"
        cargo install --list | grep -v '^    ' | head -20
        echo
    fi
}

sub_diff() {
    info "Git diff of dotfiles:"
    cd "$DOTFILES"
    git diff
}

# Utility Commands
sub_version() {
    echo "Dotfiles Manager v2.0"
    echo "Repository: $DOTFILES"
    echo "Git version: $(git -C "$DOTFILES" describe --tags --always 2>/dev/null || echo 'No tags')"
}

case $COMMAND_NAME in
"" | "-h" | "--help")
	sub_help
	;;
"status" | "sync" | "backup" | "restore" | "link" | "unlink" | "check" | "clean" | "install" | "update" | "macos" | "edit" | "packages" | "diff" | "version")
	shift
	sub_${COMMAND_NAME} "$@"
	;;
*)
	error "'$COMMAND_NAME' is not a known command."
	echo
	sub_help
	exit 1
	;;
esac
