#!/usr/bin/env python3

import subprocess
import sys


def run_git_diff(args):
    base = [
        "git",
        "diff",
        "--unified=0",
        "--minimal",
        "--no-color",
        "--no-ext-diff",
        "--find-renames",
        "--find-copies",
        "--no-textconv",
    ]
    cmd = base + args
    p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if p.returncode not in (0, 1):  # 1 means differences found, still ok
        sys.stderr.write(p.stderr.decode("utf-8", "replace"))
        sys.exit(p.returncode)
    return p.stdout.decode("utf-8", "replace").splitlines()


def compact(lines):
    out = []
    current_file = None
    file_status = None  # ADDED | DELETED | MODIFIED | None
    for line in lines:
        if line.startswith("diff --git "):
            # separate files with a blank line except before the first
            if current_file is not None:
                out.append("")
            current_file = ""
            file_status = None
            # parse paths
            try:
                _, _, a, b = line.split(" ", 3)
                a = a[2:] if a.startswith("a/") else a
                b = b[2:] if b.startswith("b/") else b
            except Exception:
                a = b = "UNKNOWN"
            header = f"=== FILE: {b}"
            if a != b:
                header += f" (rename from {a})"
            out.append(header)
            continue

        if line.startswith("new file mode "):
            file_status = "ADDED"
            continue
        if line.startswith("deleted file mode "):
            file_status = "DELETED"
            continue

        if line.startswith("Binary files ") and line.endswith(" differ"):
            out.append("--- BINARY CHANGE ---")
            continue

        if line.startswith("@@ "):
            out.append(line)
            continue

        # keep only +/- lines, skip +++/--- path lines
        if line and line[0] in "+-":
            if line.startswith("+++ ") or line.startswith("--- "):
                continue
            if file_status == "ADDED" and line[0] == "-":
                continue
            if file_status == "DELETED" and line[0] == "+":
                continue
            out.append(line)
            continue

        # ignore boilerplate/meta lines
        if line.startswith(
            (
                "index ",
                "old mode ",
                "new mode ",
                "similarity index ",
                "rename from ",
                "rename to ",
                "copy from ",
                "copy to ",
                "+++ ",
                "--- ",
            )
        ):
            continue

        # ignore everything else
        continue

    return out


def main():
    args = sys.argv[1:]
    lines = run_git_diff(args)
    print("\n".join(compact(lines)))


if __name__ == "__main__":
    main()
