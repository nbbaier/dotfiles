#compdef vt

# zsh completion support for vt v0.1.50

autoload -U is-at-least

# shellcheck disable=SC2154
(( $+functions[__vt_complete] )) ||
function __vt_complete {
  local name="$1"; shift
  local action="$1"; shift
  integer ret=1
  local -a values
  local expl lines
  _tags "$name"
  while _tags; do
    if _requested "$name"; then
      # shellcheck disable=SC2034
      lines="$(vt completions complete "${action}" "${@}")"
      values=("${(ps:\n:)lines}")
      if (( ${#values[@]} )); then
        while _next_label "$name" expl "$action"; do
          compadd -S '' "${expl[@]}" "${values[@]}"
        done
      fi
    fi
  done
}

# shellcheck disable=SC2154
_vt() {
  local state

  function _commands() {
    local -a commands
    # shellcheck disable=SC2034
    commands=(
      'profile:Get information about the currently authenticated user (you!)'
      'upgrade:Upgrade vt executable to latest or given version.'
      'clone:Clone a Val'
      'push:Push local changes to a Val'
      'pull:Pull the latest changes for the current Val'
      'status:Show the working tree status'
      'branch:List or delete branches'
      'checkout:Check out a different branch'
      'watch:Watch for changes and automatically sync with Val Town'
      'browse:Open a Val'"'"'s main page in a web browser'
      'create:Create a new Val'
      'remix:Remix a Val'
      'config:Manage vt configuration'
      'delete:Delete the current Val'
      'list:List all your Vals'
      'tail:Stream logs of a Val'
      'completions:Generate shell completions.'
    )
    _describe 'command' commands
  }

  function _command_args() {
    case "${words[1]}" in
      profile|me) _vt_profile ;;
      upgrade) _vt_upgrade ;;
      clone) _vt_clone ;;
      push) _vt_push ;;
      pull) _vt_pull ;;
      status) _vt_status ;;
      branch) _vt_branch ;;
      checkout) _vt_checkout ;;
      watch) _vt_watch ;;
      browse) _vt_browse ;;
      create) _vt_create ;;
      remix) _vt_remix ;;
      config) _vt_config ;;
      delete) _vt_delete ;;
      list) _vt_list ;;
      tail) _vt_tail ;;
      completions) _vt_completions ;;
    esac
  }

  _arguments -w -s -S -C \
    '(- *)'{-h,--help}'[Show this help.]' \
    '(- *)'{-V,--version}'[Show the version number for this program.]' \
    '1:command:_commands' \
    '*::sub command:->command_args'

  case "$state" in
    command_args) _command_args ;;
  esac
}

